{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azure-eclipse",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
